@using Nurtura.Core
@using Nurtura.Web.Localization
@model Nurtura.Core.Services.AvailabilityWeek
@{
    ViewData["Title"] = L["Availability_Title"];
    var statusMessage = TempData["StatusMessage"] as string;
    var weekStart = Model.WeekStart.ToString(DateFormats.Display);

    // On a phone one day shows at a time: today when it is in this week, otherwise Monday.
    var todayIndex = Model.Days.ToList().FindIndex(d => d.Date == PolandTime.Today);
    var activeDay = todayIndex >= 0 ? todayIndex : 0;
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-body-secondary mb-3">@L["Availability_Intro"]</p>

        @if (statusMessage is not null)
        {
            <div class="alert alert-success" role="status">@statusMessage</div>
        }

        <div class="d-flex align-items-center justify-content-between mb-3">
            @if (Model.PreviousWeekStart is { } previous)
            {
                <a asp-action="Index" asp-route-date="@previous.ToString(DateFormats.Display)" class="btn btn-outline-primary"
                   aria-label="@L["Availability_PreviousWeek"]" title="@L["Availability_PreviousWeek"]">&lsaquo;</a>
            }
            else
            {
                <span class="btn btn-outline-primary invisible" aria-hidden="true">&lsaquo;</span>
            }
            <span class="fw-semibold text-center">
                @L["Availability_Range", weekStart, Model.Days[^1].Date.ToString(DateFormats.Display)]
            </span>
            @if (Model.NextWeekStart is { } next)
            {
                <a asp-action="Index" asp-route-date="@next.ToString(DateFormats.Display)" class="btn btn-outline-primary"
                   aria-label="@L["Availability_NextWeek"]" title="@L["Availability_NextWeek"]">&rsaquo;</a>
            }
            else
            {
                <span class="btn btn-outline-primary invisible" aria-hidden="true">&rsaquo;</span>
            }
        </div>

        @if (Model.IsCopied)
        {
            <div class="alert alert-info" role="status">@L["Availability_Copied"]</div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <span class="fw-semibold" id="availability-count" data-template="@L["Availability_OpenCount", "{0}"]">
                @L["Availability_OpenCount", Model.OpenCount]
            </span>
            <a asp-action="Index" asp-route-date="@weekStart" asp-route-copy="true" class="btn btn-outline-secondary btn-sm">
                @L["Availability_CopyLastWeek"]
            </a>
        </div>

        <form asp-action="Index" method="post" data-submit-once id="availability-form">
            <input type="hidden" name="weekStart" value="@weekStart" />

            @* Phone: one day at a time, picked with these tabs. *@
            <div class="d-flex d-md-none gap-1 mb-3" role="group" aria-label="@L["Availability_Days"]">
                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var day = Model.Days[i];
                    // A day that is completely past gets grey tabs, like its grey header.
                    var variant = day.Hours.All(h => h.IsPast) ? "secondary" : "primary";
                    <button type="button" class="btn btn-sm flex-fill px-0 lh-sm @(i == activeDay ? "btn-" + variant : "btn-outline-" + variant)"
                            data-day-tab="@i" data-variant="@variant" aria-pressed="@(i == activeDay ? "true" : "false")">
                        <span class="d-block small">@L["Weekday_Short_" + day.Date.DayOfWeek]</span>
                        <span class="d-block small">@day.Date.ToString("dd-MM")</span>
                    </button>
                }
            </div>

            @* Laptop: days across, hours down. *@
            <div class="row g-2 mb-3">
                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var day = Model.Days[i];
                    var dayName = L["Weekday_Short_" + day.Date.DayOfWeek];
                    <div class="col-12 col-md @(i == activeDay ? "" : "d-none d-md-block")" data-day="@i">
                        <div class="text-center fw-semibold small mb-2 @(day.Hours.All(h => h.IsPast) ? "text-body-secondary" : "")">
                            @* Today's column says "Today" in place of the weekday, so every header keeps the same height. *@
                            @if (day.Date == PolandTime.Today)
                            {
                                <span class="fw-bold">@L["Availability_Today"]</span>
                            }
                            else
                            {
                                @dayName
                            }
                            <br class="d-none d-md-inline" />
                            <span class="fw-normal">@day.Date.ToString(DateFormats.Display)</span>
                        </div>
                        @foreach (var hour in day.Hours)
                        {
                            var time = new TimeOnly(hour.Hour, 0).ToString(TimeFormats.Display);
                            if (hour.IsPast)
                            {
                                // Already started: not a control, only shows whether the hour was open
                                // (dark grey fill) or closed (light grey).
                                <div class="w-100 mb-1 py-2 py-md-1 border rounded text-center user-select-none @(hour.IsOpen ? "bg-secondary border-secondary text-white" : "bg-body-secondary border-secondary-subtle text-body-secondary")"
                                     data-fixed-open="@(hour.IsOpen ? "true" : null)">
                                    @time
                                    <span class="visually-hidden">@L[hour.IsOpen ? "Availability_PastOpen" : "Availability_PastClosed"]</span>
                                </div>
                                continue;
                            }

                            if (hour.IsBooked)
                            {
                                // A request or appointment holds this hour: it stays open and cannot be closed.
                                <div class="w-100 mb-1 py-2 py-md-1 border border-primary rounded text-center user-select-none bg-primary-subtle text-primary-emphasis fw-semibold"
                                     data-fixed-open="true">
                                    @time
                                    <span class="visually-hidden">@L["Availability_Booked"]</span>
                                </div>
                                continue;
                            }

                            var id = $"slot-{i}-{hour.Hour}";
                            <input type="checkbox" class="btn-check" id="@id" name="open" value="@($"{i}-{hour.Hour}")"
                                   autocomplete="off" checked="@hour.IsOpen"
                                   aria-label="@dayName @day.Date.ToString(DateFormats.Display) @time" />
                            <label class="btn btn-outline-primary w-100 mb-1 py-2 py-md-1" for="@id">@time</label>
                        }
                    </div>
                }
            </div>

            <p class="small text-body-secondary mb-1">@L["Availability_PastHint"]</p>
            <p class="small text-body-secondary">
                <span class="d-inline-block align-middle border border-primary rounded bg-primary-subtle me-1 px-2" aria-hidden="true">&nbsp;</span>
                @L["Availability_BookedHint"]
            </p>

            <button type="submit" class="btn btn-primary w-100 mb-4">@L["Availability_Save"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/availability.js" asp-append-version="true"></script>
}
