@{
    ViewData["Title"] = L["Professional_Home_Title"];
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        <a asp-area="Professional" asp-controller="Availability" asp-action="Index" class="card text-decoration-none mb-3">
            <div class="card-body">
                <h2 class="h5 card-title mb-1">@L["Professional_Home_AvailabilityLink"]</h2>
                <p class="card-text text-body-secondary mb-0">@L["Professional_Home_AvailabilityText"]</p>
            </div>
        </a>

        <a asp-area="Professional" asp-controller="Appointments" asp-action="Index" class="card text-decoration-none mb-3">
            <div class="card-body">
                <h2 class="h5 card-title mb-1">@L["Professional_Home_AppointmentsLink"]</h2>
                <p class="card-text text-body-secondary mb-0">@L["Professional_Home_AppointmentsText"]</p>
            </div>
        </a>
    </div>
</div>
