@using Nurtura.Web.Localization
@model Nurtura.Core.Services.ProfessionalAppointments
@{
    ViewData["Title"] = L["Appointments_Title"];
    var statusMessage = TempData["StatusMessage"] as string;
    var problemMessage = TempData["ProblemMessage"] as string;
    var sections = new[]
    {
        (Key: "Appointments_Requests", Empty: "Appointments_NoRequests", Items: Model.Requests),
        (Key: "Appointments_Upcoming", Empty: "Appointments_NoUpcoming", Items: Model.Upcoming),
        (Key: "Appointments_Past", Empty: "Appointments_NoPast", Items: Model.Past)
    };
    // Ended sessions without a closing note; the line at the top jumps to the first of them.
    var notesToWrite = Model.Past.Where(a => a.NeedsClosingNote).ToList();
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        @await Html.PartialAsync("_ConsultationBanner", ViewData["Banners"])

        @if (notesToWrite.Count > 0)
        {
            <p class="mb-3">
                <a href="#appointment-@notesToWrite[0].Id">@L[Plural.Key("Appointments_NotesToWrite", notesToWrite.Count), notesToWrite.Count]</a>
            </p>
        }

        @if (statusMessage is not null)
        {
            <div class="alert alert-success" role="status">@statusMessage</div>
        }

        @if (problemMessage is not null)
        {
            <div class="alert alert-warning" role="alert">@problemMessage</div>
        }

        @foreach (var section in sections)
        {
            <h2 class="h5 mt-4 mb-2">@L[section.Key]</h2>
            @if (section.Items.Count == 0)
            {
                <p class="text-body-secondary">@L[section.Empty]</p>
            }
            @foreach (var item in section.Items)
            {
                <partial name="_AppointmentCard" model="item" />
            }
        }
    </div>
</div>
