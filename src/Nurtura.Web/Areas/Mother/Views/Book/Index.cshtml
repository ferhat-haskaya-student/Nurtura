@using Nurtura.Web.Areas.Mother.Controllers
@using Nurtura.Web.Areas.Mother.Models
@{
    ViewData["Title"] = L["Book_Title"];
    var statusMessage = TempData["StatusMessage"] as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-body-secondary mb-3">@L["Book_TopicIntro"]</p>

        @if (statusMessage is not null)
        {
            <div class="alert alert-success" role="status">@statusMessage</div>
        }

        <partial name="_AssistantSearch"
                 model="new AssistantSearchBox(AssistantController.LabelKey(AssistantController.FromBook), AssistantController.FromBook)" />

        <partial name="_TopicButtons" />
    </div>
</div>
