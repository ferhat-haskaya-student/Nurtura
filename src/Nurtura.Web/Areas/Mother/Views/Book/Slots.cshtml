@using Nurtura.Core.Entities
@using Nurtura.Web.Areas.Mother
@model IReadOnlyList<Nurtura.Core.Services.FreeSlotDay>
@{
    var topic = (Topic)ViewData["Topic"]!;
    var language = ViewData["Language"] as Language?;
    ViewData["Title"] = L["Book_SlotsTitle", L["Topic_" + topic]];
    var filters = new (Language? Value, string Key)[]
    {
        (null, "Book_AnyLanguage"),
        (Language.Polish, "Book_Polish"),
        (Language.English, "Book_English")
    };
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <a asp-action="Index" class="d-inline-block mb-2">&lsaquo; @L["Book_ChangeTopic"]</a>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-body-secondary mb-3">@L["Book_SlotsIntro"]</p>

        <div class="btn-group w-100 mb-4" role="group" aria-label="@L["Book_LanguageFilter"]">
            @foreach (var filter in filters)
            {
                var isActive = filter.Value == language;
                <a asp-action="Slots" asp-route-topic="@topic" asp-route-language="@filter.Value"
                   class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-primary")"
                   aria-current="@(isActive ? "true" : null)">@L[filter.Key]</a>
            }
        </div>

        @if (Model.Count == 0)
        {
            <p class="mb-4">@L["Book_NoSlots"]</p>
        }

        @foreach (var day in Model)
        {
            <h2 class="h6 fw-semibold mt-3 mb-2">@BookText.Day(L, day.Date)</h2>
            <div class="list-group mb-3">
                @foreach (var slot in day.Slots)
                {
                    var professional = slot.Professional;
                    <div class="list-group-item py-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="text-break">
                                <div class="fw-semibold">@BookText.HourRange(slot.Hour)</div>
                                <a asp-action="Professional" asp-route-id="@professional.Id" asp-route-topic="@topic"
                                   asp-route-language="@language">@professional.DisplayName</a>
                                <div class="small text-body-secondary">
                                    @L["ProfessionalType_" + professional.Type] · @BookText.Languages(L, professional.Languages)
                                </div>
                            </div>
                            <a asp-action="Request" asp-route-slotId="@slot.SlotId" asp-route-topic="@topic"
                               class="btn btn-primary btn-sm flex-shrink-0">@L["Book_RequestButton"]</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
