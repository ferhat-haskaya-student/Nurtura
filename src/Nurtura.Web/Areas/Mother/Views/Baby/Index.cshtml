@using Nurtura.Core.Entities
@using Nurtura.Core.Services
@using Nurtura.Web.Areas.Mother
@using Nurtura.Web.Localization
@model Nurtura.Web.Areas.Mother.Models.BabySectionViewModel
@{
    ViewData["Title"] = L["Baby_Title"];
    var statusMessage = TempData["StatusMessage"] as string;
    var baby = Model.Selected;
    var sleep = Model.Sleep!;
    var now = DateTime.UtcNow;
}

<div class="row justify-content-center" data-server-now="@(new DateTimeOffset(now).ToUnixTimeMilliseconds())">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        @if (statusMessage is not null)
        {
            <div class="alert alert-success" role="status">@statusMessage</div>
        }

        @if (Model.Babies.Count >= 2)
        {
            <nav class="d-flex flex-wrap gap-2 mb-3" aria-label="@L["Baby_Select"]">
                @foreach (var item in Model.Babies)
                {
                    var isSelected = item.Id == baby?.Id;
                    <a asp-area="Mother" asp-controller="Baby" asp-action="Index" asp-route-id="@item.Id"
                       class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-primary")"
                       aria-current="@(isSelected ? "true" : null)">@item.Name</a>
                }
            </nav>
        }

        @if (baby is not null)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h4 card-title text-break mb-3">@baby.Name</h2>
                    <dl class="row mb-2">
                        <dt class="col-5">@L["Baby_BirthDate"]</dt>
                        <dd class="col-7">@baby.BirthDate.ToString(DateFormats.Display)</dd>
                        <dt class="col-5">@L["Baby_Age"]</dt>
                        <dd class="col-7">@BabyText.Age(L, Model.Age!)</dd>
                        <dt class="col-5">@L["Baby_FeedingType"]</dt>
                        <dd class="col-7 mb-0">@L["BabyFeedingType_" + baby.FeedingType]</dd>
                    </dl>
                    <a asp-area="Mother" asp-controller="Baby" asp-action="Edit" asp-route-id="@baby.Id">@L["Baby_Edit"]</a>
                </div>
            </div>

            <div class="row g-2 mb-2">
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5 card-title mb-1">
                                <a asp-area="Mother" asp-controller="Sleep" asp-action="Timer" asp-route-id="@baby.Id"
                                   class="stretched-link text-reset text-decoration-none">@L["Sleep_Title"]</a>
                            </h2>
                            <p class="card-text mb-0">
                                @if (sleep.Running is not null)
                                {
                                    @L["Sleep_TileSleeping"]
                                    <span data-running-since="@(new DateTimeOffset(sleep.Running.StartTime).ToUnixTimeMilliseconds())"
                                          data-format="duration" data-template-hm="@L["Duration_HoursMinutes"]"
                                          data-template-h="@L["Duration_Hours"]" data-template-m="@L["Duration_Minutes"]">@SleepText.Duration(L, now - sleep.Running.StartTime)</span>
                                }
                                else if (sleep.Last is not null)
                                {
                                    @L["Sleep_TileLast", SleepText.Duration(L, sleep.Last), SleepText.AgoPrecise(L, now - sleep.Last.EndTime!.Value)]
                                }
                                else
                                {
                                    @L["Sleep_TileEmpty"]
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5 card-title mb-1">
                                <a asp-area="Mother" asp-controller="Feeding" asp-action="Log" asp-route-id="@baby.Id"
                                   class="stretched-link text-reset text-decoration-none">@L["Feeding_Title"]</a>
                            </h2>
                            <p class="card-text mb-0">
                                @if (Model.LastFeed is not null)
                                {
                                    @L["Feeding_TileLast", SleepText.FeedSummary(L, Model.LastFeed, full: false), SleepText.AgoPrecise(L, now - Model.LastFeed.Time)]
                                }
                                else
                                {
                                    @L["Feeding_TileEmpty"]
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            @if (sleep.Running is not null && now - sleep.Running.StartTime >= SleepRecord.LongRunning)
            {
                <p class="small text-body-secondary mb-2">
                    @L["Sleep_LongRunning"]
                    <a asp-area="Mother" asp-controller="Sleep" asp-action="Edit" asp-route-id="@sleep.Running.Id"
                       asp-fragment="end">@L["Sleep_SetEndTime"]</a>
                </p>
            }

            @* The last 7 days at a glance: what was logged, never compared with any reference figure. *@
            @if (Model.Routine is { } routine)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-2">@L["Routine_Title"]</h2>
                        @* Averages need a full routine day (07:00 to 07:00); today alone is not enough. *@
                        @if (routine.HasFullDay)
                        {
                            var sleepLine = RoutineText.SleepLine(L, routine);
                            var feedLine = RoutineText.FeedLine(L, routine);
                            @if (sleepLine is not null)
                            {
                                <p class="card-text mb-1">@sleepLine</p>
                            }
                            @if (feedLine is not null)
                            {
                                <p class="card-text mb-1">@feedLine</p>
                            }
                        }
                        else
                        {
                            <p class="card-text text-body-secondary mb-1">@L["Routine_Empty"]</p>
                        }
                        @if (routine.HasAny)
                        {
                            <a asp-area="Mother" asp-controller="Baby" asp-action="Routine" asp-route-id="@baby.Id">@L["Routine_SeeMore"]</a>
                        }
                    </div>
                </div>
            }

            @* One list of sleeps and feeds, newest first. A sleep sits at its start time; the running one is on its tile. *@
            @if (Model.Timeline.Count > 0)
            {
                <h2 class="h5 mt-4 mb-2">@L["Timeline_Title"]</h2>
                @foreach (var day in Model.Timeline)
                {
                    <h3 class="h6 text-body-secondary mt-3 mb-1">@L["Weekday_" + day.Date.DayOfWeek] @day.Date.ToString(DateFormats.Display)</h3>
                    <div class="list-group mb-2">
                        @foreach (var entry in day.Entries)
                        {
                            var (controller, entryId, label, text, note, shared) = entry.Sleep is { } item
                                ? ("Sleep", item.Id, L["Timeline_Sleep"].Value,
                                    L["Sleep_ListItem", SleepText.Range(L, item), SleepText.Duration(L, item)].Value, item.Note, item.IsShared)
                                : ("Feeding", entry.Feed!.Id, L["Timeline_Feeding"].Value,
                                    SleepText.FeedSummary(L, entry.Feed, full: true), entry.Feed.Note, entry.Feed.IsShared);
                            <a asp-area="Mother" asp-controller="@controller" asp-action="Edit" asp-route-id="@entryId"
                               class="list-group-item list-group-item-action">
                                <span class="badge text-bg-secondary me-1">@label</span>
                                @text
                                @if (note is not null)
                                {
                                    <span class="badge text-bg-light border">@L["CheckIn_HasNote"]</span>
                                }
                                @if (shared)
                                {
                                    <span class="badge text-bg-light border">@L["CheckIn_Shared"]</span>
                                }
                            </a>
                        }
                    </div>
                }
            }

            <p class="small mt-4 mb-2">
                <a asp-area="Mother" asp-controller="Guides" asp-action="Index" asp-fragment="for-your-baby">@L["Guides_Related"]</a>
            </p>

            <p class="mb-0">
                <a asp-area="Mother" asp-controller="Baby" asp-action="Add">@L["Baby_Add"]</a>
            </p>
        }
        else
        {
            <a asp-area="Mother" asp-controller="Baby" asp-action="Add" class="btn btn-primary w-100">@L["Baby_Add"]</a>
        }
    </div>
</div>

@section Scripts {
    @if (Model.Sleep?.Running is not null)
    {
        <script src="~/js/sleep-timer.js" asp-append-version="true"></script>
    }
}
