@model Nurtura.Web.Areas.Mother.Models.BabyFormModel
@{
    ViewData["Title"] = L["Baby_Add"];
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        <form asp-area="Mother" asp-controller="Baby" asp-action="Add" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <partial name="_BabyFields" model="Model" />

            <button type="submit" class="btn btn-primary w-100 mb-3">@L["Baby_Save"]</button>
        </form>

        <a asp-area="Mother" asp-controller="Baby" asp-action="Index">@L["Baby_Cancel"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
