@using Nurtura.Web.Areas.Mother
@model Nurtura.Web.Areas.Mother.Models.RoutineViewModel
@{
    ViewData["Title"] = L["Routine_Title"];
    var routine = Model.Routine;
    var none = RoutineText.None;
}

@* A record of what she logged over the last 7 routine days (07:00 to 07:00). Today is shown "so far" and left out
   of every average. Never compared with reference figures; colors only tell sleep (blue) and feeds (orange) apart. *@
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <a asp-area="Mother" asp-controller="Baby" asp-action="Index" asp-route-id="@Model.Baby.Id"
           class="d-inline-block mb-2">@L["Routine_Back"]</a>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-body-secondary text-break mb-1">@L["Routine_Subtitle", Model.Baby.Name]</p>
        <p class="small text-body-secondary mb-3">@L["Routine_DayNote"]</p>

        @if (!routine.HasAny)
        {
            <p class="text-body-secondary mb-4">@L["Routine_Empty"]</p>
        }
        else
        {
            <section class="mb-4">
                <h2 class="h5 d-flex align-items-center gap-2 mb-0"><span class="routine-dot routine-dot-sleep" aria-hidden="true"></span>@L["Routine_SleepHeading"]</h2>
                @if (routine.SleepDays > 0)
                {
                    <p class="small text-body-secondary mb-2">@RoutineText.BasedOn(L, routine.SleepDays)</p>
                }
                <partial name="_RoutineSleepSection" model="routine" />
            </section>

            <section class="mb-4">
                <h2 class="h5 d-flex align-items-center gap-2 mb-0"><span class="routine-dot routine-dot-feed" aria-hidden="true"></span>@L["Routine_FeedsHeading"]</h2>
                @if (routine.FeedDays > 0)
                {
                    <p class="small text-body-secondary mb-2">@RoutineText.BasedOn(L, routine.FeedDays)</p>
                }
                <partial name="_RoutineFeedSection" model="routine" />
            </section>

            <section class="mb-4">
                <h2 class="h5 mb-2">@L["Routine_RhythmHeading"]</h2>
                <div class="card">
                    <div class="card-body p-3">
                        <p class="small text-body-secondary mb-2">@L["Routine_RhythmExplain"]</p>
                        <partial name="_RoutineChart" model="routine" />
                    </div>
                </div>
            </section>

            <section class="mb-4">
                <h2 class="h5 mb-2">@L["Routine_DayByDay"]</h2>
                @foreach (var day in routine.Days)
                {
                    <details class="routine-day card mb-2">
                        <summary class="card-body d-flex align-items-center gap-2 py-2">
                            <span class="routine-day-name">
                                <span class="fw-semibold">@RoutineText.DayShort(L, day.Date)</span>
                                @if (day.IsToday)
                                {
                                    <br /><span class="small text-body-secondary">@L["Routine_SoFar"]</span>
                                }
                            </span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-normal">@(day.HasSleep ? SleepText.Duration(L, day.SleepTotal) : none)</span>
                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis fw-normal">@RoutineText.FeedCount(L, day.Feeds.Count)</span>
                            <span class="ms-auto text-body-secondary" aria-hidden="true">›</span>
                        </summary>
                        <dl class="row small border-top mx-3 mb-0 py-2">
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_NightSleep"]</dt>
                            <dd class="col-7 text-end mb-1">@RoutineText.NightSleep(L, day)</dd>
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_Naps"]</dt>
                            <dd class="col-7 text-end mb-1">@RoutineText.Naps(L, day)</dd>
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_FeedsHeading"]</dt>
                            <dd class="col-7 text-end mb-1">@RoutineText.FeedsByType(L, day)</dd>
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_NightFeeds"]</dt>
                            <dd class="col-7 text-end mb-0">@RoutineText.NightFeeds(L, day)</dd>
                        </dl>
                    </details>
                }
            </section>
        }

        <p class="small text-body-secondary border-top pt-3 mb-4">@L["Routine_BoundaryNote"]</p>
    </div>
</div>
