@using Nurtura.Web.Areas.Mother
@model Nurtura.Web.Areas.Mother.Models.RoutineViewModel
@{
    ViewData["Title"] = L["Routine_Title"];
    var routine = Model.Routine;
    var none = RoutineText.None;
    var feedCount = routine.FeedCount;
    string Share(int count) => (100.0 * count / feedCount).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
}

@* A record of what she logged over the last 7 routine days (07:00 to 07:00). Today is shown "so far" and left out
   of every average. Never compared with reference figures; colors only tell sleep (blue) and feeds (orange) apart. *@
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <a asp-area="Mother" asp-controller="Baby" asp-action="Index" asp-route-id="@Model.Baby.Id"
           class="d-inline-block mb-2">@L["Routine_Back"]</a>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-body-secondary text-break mb-1">@L["Routine_Subtitle", Model.Baby.Name]</p>
        <p class="small text-body-secondary mb-3">@L["Routine_DayNote"]</p>

        @if (!routine.HasAny)
        {
            <p class="text-body-secondary mb-4">@L["Routine_Empty"]</p>
        }
        else
        {
            <section class="mb-4">
                <h2 class="h5 d-flex align-items-center gap-2 mb-0"><span class="routine-dot routine-dot-sleep" aria-hidden="true"></span>@L["Routine_SleepHeading"]</h2>
                @if (routine.SleepDays > 0)
                {
                    <p class="small text-body-secondary mb-2">@RoutineText.BasedOn(L, routine.SleepDays)</p>
                }
                @if (routine.HasSleep)
                {
                    <div class="card mt-2 mb-2">
                        <div class="card-body p-3">
                            <p class="small text-body-secondary mb-2">@L["Routine_SleepBarsExplain"]</p>
                            <partial name="_RoutineSleepBars" model="routine" />
                            <div class="d-flex flex-wrap gap-3 small text-body-secondary mt-1">
                                <span><span class="routine-dot routine-dot-sleep" aria-hidden="true"></span> @L["Routine_LegendNight"]</span>
                                <span><span class="routine-dot routine-dot-nap" aria-hidden="true"></span> @L["Routine_LegendNaps"]</span>
                                <span><span aria-hidden="true">– –</span> @L["Routine_LegendAverage"]</span>
                            </div>
                        </div>
                    </div>
                }
                @if (routine.SleepDays > 0)
                {
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-primary-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_SleepADay"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Duration(L, routine.AverageSleep)</div>
                                <div class="small text-body-secondary">@L["Routine_OnAverage"]</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-primary-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_NightSleep"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Duration(L, routine.AverageNight)</div>
                                <div class="small text-body-secondary">@L["Routine_NightSleepNote"]</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-primary-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_NapsADay"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Number(routine.AverageNaps!.Value)</div>
                                <div class="small text-body-secondary">@L["Routine_NapTimeNote", RoutineText.Duration(L, routine.AverageNapTime)]</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-primary-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_LongestNight"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Duration(L, routine.LongestNight?.Duration)</div>
                                @if (routine.LongestNight is not null)
                                {
                                    <div class="small text-body-secondary">@RoutineText.LongestNightNote(L, routine.LongestNight)</div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-body-secondary mb-0">@L["Routine_NoFullDay"]</p>
                }
            </section>

            <section class="mb-4">
                <h2 class="h5 d-flex align-items-center gap-2 mb-0"><span class="routine-dot routine-dot-feed" aria-hidden="true"></span>@L["Routine_FeedsHeading"]</h2>
                @if (routine.FeedDays > 0)
                {
                    <p class="small text-body-secondary mb-2">@RoutineText.BasedOn(L, routine.FeedDays)</p>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-warning-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_FeedsADay"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Number(routine.AverageFeeds!.Value)</div>
                                <div class="small text-body-secondary">@L["Routine_OnAverage"]</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-warning-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_DaytimeGap"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Duration(L, routine.AverageDaytimeGap)</div>
                                <div class="small text-body-secondary">@L["Routine_DaytimeGapNote"]</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-warning-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_NightFeeds"]</div>
                                <div class="fs-5 fw-semibold">@RoutineText.Number(routine.AverageNightFeeds!.Value) <small class="fs-6 fw-normal text-body-secondary">@L["Routine_ANight"]</small></div>
                                <div class="small text-body-secondary">@L["Routine_NightFeedsNote"]</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="h-100 rounded-3 bg-warning-subtle p-3">
                                <div class="small text-body-secondary">@L["Routine_BottleADay"]</div>
                                <div class="fs-5 fw-semibold">
                                    @if (routine.AverageBottleMl is { } ml)
                                    {
                                        @ml <small class="fs-6 fw-normal text-body-secondary">@L["Routine_Ml"]</small>
                                    }
                                    else
                                    {
                                        @none
                                    }
                                </div>
                                <div class="small text-body-secondary">@L["Routine_BottleNote"]</div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-body-secondary mb-2">@L["Routine_NoFullDay"]</p>
                }
                @if (feedCount > 0)
                {
                    <div class="rounded-3 bg-warning-subtle p-3">
                        <div class="small text-body-secondary">@L["Routine_TypeOfFeeds", feedCount]</div>
                        <div class="routine-split d-flex rounded-pill overflow-hidden my-2" aria-hidden="true">
                            <div class="routine-type-breast" style="width: @Share(routine.Breast)"></div>
                            <div class="routine-type-bottle" style="width: @Share(routine.Bottle)"></div>
                            <div class="routine-type-solid" style="width: @Share(routine.Solid)"></div>
                        </div>
                        <div class="d-flex flex-wrap gap-3 small text-body-secondary">
                            <span><span class="routine-dot routine-type-breast" aria-hidden="true"></span> @L["FeedingType_Breast"] @routine.Breast</span>
                            <span><span class="routine-dot routine-type-bottle" aria-hidden="true"></span> @L["FeedingType_Bottle"] @routine.Bottle</span>
                            <span><span class="routine-dot routine-type-solid" aria-hidden="true"></span> @L["FeedingType_Solid"] @routine.Solid</span>
                        </div>
                    </div>
                }
            </section>

            <section class="mb-4">
                <h2 class="h5 mb-2">@L["Routine_RhythmHeading"]</h2>
                <div class="card">
                    <div class="card-body p-3">
                        <p class="small text-body-secondary mb-2">@L["Routine_RhythmExplain"]</p>
                        <partial name="_RoutineChart" model="routine" />
                    </div>
                </div>
            </section>

            <section class="mb-4">
                <h2 class="h5 mb-2">@L["Routine_DayByDay"]</h2>
                @foreach (var day in routine.Days)
                {
                    <details class="routine-day card mb-2">
                        <summary class="card-body d-flex align-items-center gap-2 py-2">
                            <span class="routine-day-name">
                                <span class="fw-semibold">@RoutineText.DayShort(L, day.Date)</span>
                                @if (day.IsToday)
                                {
                                    <br /><span class="small text-body-secondary">@L["Routine_SoFar"]</span>
                                }
                            </span>
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-normal">@(day.HasSleep ? SleepText.Duration(L, day.SleepTotal) : none)</span>
                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis fw-normal">@RoutineText.FeedCount(L, day.Feeds.Count)</span>
                            <span class="ms-auto text-body-secondary" aria-hidden="true">›</span>
                        </summary>
                        <dl class="row small border-top mx-3 mb-0 py-2">
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_NightSleep"]</dt>
                            <dd class="col-7 text-end mb-1">@RoutineText.NightSleep(L, day)</dd>
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_Naps"]</dt>
                            <dd class="col-7 text-end mb-1">@RoutineText.Naps(L, day)</dd>
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_FeedsHeading"]</dt>
                            <dd class="col-7 text-end mb-1">@RoutineText.FeedsByType(L, day)</dd>
                            <dt class="col-5 fw-normal text-body-secondary">@L["Routine_NightFeeds"]</dt>
                            <dd class="col-7 text-end mb-0">@RoutineText.NightFeeds(L, day)</dd>
                        </dl>
                    </details>
                }
            </section>
        }

        <p class="small text-body-secondary border-top pt-3 mb-4">@L["Routine_BoundaryNote"]</p>
    </div>
</div>
