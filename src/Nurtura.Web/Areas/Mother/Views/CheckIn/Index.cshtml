@using Nurtura.Core
@using Nurtura.Core.Entities
@using Nurtura.Web.Localization
@model Nurtura.Web.Areas.Mother.Models.CheckInViewModel
@{
    ViewData["Title"] = L["CheckIn_Title"];
    var today = PolandTime.Today;
    var date = Model.Date?.ToString(DateFormats.Display);
    var statusMessage = TempData["StatusMessage"] as string;
    // Property name and resource key prefix for each 1 to 5 rating.
    var ratings = new[]
    {
        nameof(Model.Mood), nameof(Model.SleepQuality), nameof(Model.Energy), nameof(Model.Stress)
    };
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h1 class="h3 mb-0">@ViewData["Title"]</h1>
            <a asp-area="Mother" asp-controller="CheckIn" asp-action="Week" asp-route-date="@date">@L["CheckIn_WeekLink"]</a>
        </div>

        @if (statusMessage is not null)
        {
            <div class="alert alert-success" role="status">@statusMessage</div>
        }

        <form asp-area="Mother" asp-controller="CheckIn" asp-action="Index" method="get" class="mb-2" data-checkin-date-form>
            <label for="checkin-date" class="form-label">@L["CheckIn_Date"]</label>
            <input id="checkin-date" name="date" value="@date" type="text" class="form-control"
                   placeholder="@L["Date_Placeholder"]" inputmode="numeric" autocomplete="off"
                   data-date-input data-date-min="@today.AddDays(-DailyCheckIn.EditableDays).ToString(DateFormats.Display)"
                   data-date-max="@today.ToString(DateFormats.Display)" />
            <div class="form-text">@L["CheckIn_DateHint", DailyCheckIn.EditableDays]</div>
        </form>

        <p class="text-body-secondary mb-4">
            @(Model.IsExisting ? L["CheckIn_EditingExisting", date ?? ""] : L["CheckIn_New", date ?? ""])
        </p>

        <form asp-area="Mother" asp-controller="CheckIn" asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" name="Date" value="@date" />
            <span asp-validation-for="Date" class="text-danger d-block mb-3"></span>

            @foreach (var rating in ratings)
            {
                <fieldset class="mb-4">
                    <legend class="form-label fs-6 fw-semibold mb-1">@L["CheckIn_" + rating]</legend>
                    <p class="form-text mt-0 mb-2">@L["CheckIn_" + rating + "_Hint"]</p>
                    <div class="btn-group w-100" role="group">
                        @for (var value = DailyCheckIn.RatingMin; value <= DailyCheckIn.RatingMax; value++)
                        {
                            var id = rating + "-" + value;
                            @Html.RadioButton(rating, value, new { @class = "btn-check", id, autocomplete = "off" })
                            <label class="btn btn-outline-primary py-2 fs-5" for="@id">@value</label>
                        }
                    </div>
                    <div class="d-flex justify-content-between small text-body-secondary mt-1">
                        <span>1 = @L["CheckIn_" + rating + "_Low"]</span>
                        <span class="text-end">5 = @L["CheckIn_" + rating + "_High"]</span>
                    </div>
                    @Html.ValidationMessage(rating, new { @class = "text-danger" })
                </fieldset>
            }

            <fieldset class="mb-4">
                <legend class="form-label fs-6 fw-semibold mb-1">@L["CheckIn_FeelingTags"]</legend>
                <p class="form-text mt-0 mb-2">@L["CheckIn_FeelingTags_Hint"]</p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var tag in Model.AvailableTags)
                    {
                        var id = "tag-" + tag.Id;
                        <input class="btn-check" type="checkbox" name="FeelingTagIds" id="@id" value="@tag.Id" autocomplete="off"
                               checked="@Model.FeelingTagIds.Contains(tag.Id)" />
                        <label class="btn btn-outline-secondary rounded-pill" for="@id">@L["FeelingTag_" + tag.Key]</label>
                    }
                </div>
                <span asp-validation-for="FeelingTagIds" class="text-danger"></span>
            </fieldset>

            <div class="mb-4">
                <label asp-for="Note" class="form-label fw-semibold"></label>
                <textarea asp-for="Note" class="form-control" rows="4" maxlength="@DailyCheckIn.NoteMaxLength"
                          data-note-input></textarea>
                <div class="form-text text-end" data-note-counter data-template="@L["CheckIn_NoteCounter"]"
                     data-max="@DailyCheckIn.NoteMaxLength" aria-live="polite"></div>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <fieldset class="mb-4">
                <legend class="form-label fs-6 fw-semibold mb-1">@L["CheckIn_Sharing"]</legend>
                @foreach (var shared in new[] { false, true })
                {
                    var id = "shared-" + shared.ToString().ToLowerInvariant();
                    <div class="form-check mb-2">
                        <input asp-for="IsShared" class="form-check-input" type="radio" id="@id"
                               value="@shared.ToString().ToLowerInvariant()" />
                        <label class="form-check-label" for="@id">
                            <span class="fw-semibold">@L[shared ? "CheckIn_Sharing_Shared" : "CheckIn_Sharing_Private"]</span>
                            <span class="d-block small text-body-secondary">@L[shared ? "CheckIn_Sharing_Shared_Hint" : "CheckIn_Sharing_Private_Hint"]</span>
                        </label>
                    </div>
                }
            </fieldset>

            <button type="submit" class="btn btn-primary w-100 mb-4">@L["CheckIn_Submit"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Picking another day opens that day's check-in.
            var dateForm = document.querySelector('[data-checkin-date-form]');
            dateForm.querySelector('input[name="date"]').addEventListener('change', function () {
                dateForm.submit();
            });
        })();
    </script>
    <script src="~/js/note-counter.js" asp-append-version="true"></script>
}
