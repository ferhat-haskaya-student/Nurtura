@using System.Globalization
@using Nurtura.Core
@using Nurtura.Core.Services
@using Nurtura.Web.Localization
@model List<Nurtura.Core.Services.HiddenItem>
@{
    ViewData["Title"] = L["AdminReports_HiddenTitle"];
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <p class="mb-2 small">
            <a asp-action="Index">&lsaquo; @L["AdminReports_Back"]</a>
        </p>
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        <partial name="_AdminMessages" />

        @if (Model.Count == 0)
        {
            <p class="text-body-secondary">@L["AdminReports_HiddenNone"]</p>
        }

        @foreach (var item in Model)
        {
            var hiddenAt = PolandTime.ToLocal(item.HiddenAt);
            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-2">
                        <span class="badge text-bg-light border">@L["AdminReports_Kind_" + item.Kind]</span>
                    </div>
                    @if (item.Kind == ModerationKind.Comment)
                    {
                        <div class="small text-body-secondary mb-1 text-break">
                            @L["AdminReports_OnPost", string.IsNullOrEmpty(item.PostTitle) ? L["AdminReports_NoTitle"].Value : item.PostTitle]
                        </div>
                    }
                    else
                    {
                        <h2 class="h6 mb-1 text-break">@item.PostTitle</h2>
                    }
                    <div class="small text-body-secondary mb-2">
                        @(item.AuthorName ?? L["Forum_DeletedUser"].Value) ·
                        @L["AdminReports_HiddenOn", hiddenAt.ToString(DateFormats.Display, CultureInfo.InvariantCulture) + " " + hiddenAt.ToString(TimeFormats.Display, CultureInfo.InvariantCulture)]
                    </div>
                    <div class="border rounded p-2 mb-3 text-break" style="white-space: pre-wrap">@item.Text</div>
                    <form asp-action="Unhide" asp-route-kind="@item.Kind" asp-route-id="@item.Id" method="post" data-submit-once>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">@L["AdminReports_Unhide"]</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
