@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex align-items-center gap-2 py-2 py-sm-0 me-sm-3">
        <span class="text-muted small text-break">@User.Identity.Name</span>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-sm btn-outline-dark">@L["Nav_Logout"]</button>
        </form>
    </div>
}
else
{
    <ul class="navbar-nav me-sm-3">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">@L["Nav_Login"]</a>
        </li>
    </ul>
}
